# ==============================================================================
# Relay Backend Environment Configuration Template
# ==============================================================================

# --- Environment & Server ---
# Set to 'production' on Render; defaults to 'development' locally
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# --- Database Connectivity ---
# Local SQLite (default for development):
DATABASE_URL=sqlite:///./relay.db
# Production Neon PostgreSQL (Render Web Service):
# DATABASE_URL=postgresql://neondb_owner:<password>@<ep-cool-subdomain>.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- CORS & Frontend Domain ---
# Comma-separated list or JSON array of allowed origins for the Vercel frontend:
# Example: https://relay-three.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Switch Human Operator & Two-Phase Approval Security ---
# REQUIRED in production: 32+ character high-entropy secret for HMAC token signing
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SWITCH_OPERATOR_SECRET=your_secure_random_operator_secret_here
APPROVAL_TOKEN_EXPIRE_MINUTES=10

# --- Gemini LLM Provider Settings ---
# Free-tier Gemini API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=3

# --- Mattermost Integration for Human Identity (Optional) ---
MATTERMOST_URL=http://127.0.0.1:52067
MATTERMOST_API_URL=http://127.0.0.1:52067/api/v4
MATTERMOST_TIMEOUT_SECONDS=10.0

# --- Document Storage ---
UPLOAD_DIR=data/uploads
MAX_FILE_SIZE_BYTES=26214400
