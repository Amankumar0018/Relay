# Relay Environment Configuration Template
# Copy this file to .env (or backend/.env) and populate the values.
# NEVER commit production API keys or credentials to version control.

# Core Application Settings
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database Configuration (SQLite file-based WAL storage)
DATABASE_URL=sqlite:///./relay.db

# AI Provider Integration (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Security & Governance Credentials
# SWITCH_OPERATOR_SECRET is required to authorize adjudication operations.
SWITCH_OPERATOR_SECRET=your_secure_random_operator_secret_here

# Mattermost Integration for Human Reviewer Authentication
MATTERMOST_URL=http://127.0.0.1:52067
MATTERMOST_API_URL=http://127.0.0.1:52067/api/v4
MATTERMOST_TIMEOUT_SECONDS=10.0

# Relay MCP & Client Base URL
RELAY_API_URL=http://127.0.0.1:8000
RELAY_API_TIMEOUT=60.0

